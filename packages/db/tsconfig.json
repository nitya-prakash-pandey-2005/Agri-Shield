{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "../../apps/web/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
