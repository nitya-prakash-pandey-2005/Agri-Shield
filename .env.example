# ─────────────────────────────────────────────────────────────
# Agri-SHIELD environment. EVERYTHING IS OPTIONAL — the platform
# runs end-to-end on free open data (Open-Meteo, GloFAS, NASA,
# GDACS, SoilGrids) with an in-memory seeded store when unset.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Agri-SHIELD
NEXT_PUBLIC_DEMO_MODE=true          # demo OTP 123456 + one-click demo logins
AGRI_SCENARIO=live                  # live | monsoon_surge | cyclone_landfall | dry_season_salinity
AGRI_OFFLINE=false                  # true = never call external APIs (seeded data only)
OPEN_METEO_API_KEY=                 # optional commercial Open-Meteo key: removes free-tier quotas, faster refresh

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Database (optional — Postgres 16 + PostGIS; see docker-compose.yml)
DATABASE_URL=postgresql://agrishield:agrishield_dev_password@localhost:5432/agrishield
REDIS_URL=redis://localhost:6379
ENABLE_WORKERS=false

# Persistence of app state (users, orgs, alerts, audit, workspaces, dashboards, …).
# With DATABASE_URL set, snapshots go to the Postgres table app_state (created on
# demand; migration 0002_app_state). Otherwise they are files in AGRI_DATA_DIR.
# Unset/auto = postgres when DATABASE_URL is set, else file. Always off under vitest.
AGRI_PERSIST=auto                   # auto | file | postgres | off
# AGRI_DATA_DIR=/var/lib/agri-shield # file driver directory (default apps/web/.data/)
AGRI_PERSIST_INTERVAL_MS=10000      # how often changed stores are saved (min 1000)

# ML API (FastAPI service in apps/ml-api)
ML_API_URL=http://localhost:8000
NEXT_PUBLIC_ML_API_URL=http://localhost:8000
ML_API_KEY=

# LLM for the AI Advisor (any one; falls back to retrieval-grounded local engine)
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=                    # e.g. http://localhost:11434 for a fully local open-source LLM

# Notifications (fall back to an in-app outbox when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
RESEND_API_KEY=

# Web Push (VAPID, RFC 8292): free device notifications, no Firebase account.
# Generate once with `npx web-push generate-vapid-keys` and keep them stable:
# rotating keys invalidates every existing subscription. When unset, a key pair
# is generated on first use and saved to AGRI_DATA_DIR/vapid.json
# (default apps/web/.data/). Push requires HTTPS (http://localhost is allowed).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# Translation (falls back to free MyMemory API)
DEEPL_API_KEY=

# Maps (Leaflet + free CARTO/Esri/NASA GIBS tiles are used by default)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Payments (checkout runs in sandbox/simulated mode when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Monitoring
SENTRY_DSN=
POSTHOG_KEY=

# Feature flags
NEXT_PUBLIC_ENABLE_VOICE_INPUT=true
NEXT_PUBLIC_ENABLE_CAMERA_DISEASE=false
